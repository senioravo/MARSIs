# Neon connection string (Dashboard → Connection details → "Pooled connection").
# Example: postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Port for the API. The Vite dev server proxies /api here.
PORT=8787

# Comma-separated origins allowed to call the API directly (production frontend URL, etc.).
ALLOWED_ORIGINS=http://localhost:5173

# ── Microsoft Entra ID (Azure AD)
# API app registration ("MARSIS API"): validates access tokens issued for it.
AZURE_TENANT_ID=3d18c376-f6dc-497a-97cd-b0ab59e7f289
AZURE_API_CLIENT_ID=bf64aa5f-3d08-417b-b947-ffc7c3ee52e0
AZURE_API_APP_ID_URI=api://bf64aa5f-3d08-417b-b947-ffc7c3ee52e0
AZURE_REQUIRED_SCOPE=access_as_user
# SPA app registration(s) allowed to call this API (token azp/appid claim), comma-separated.
AZURE_ALLOWED_CLIENT_IDS=a2074980-ae25-4e41-9a02-cc4973ace8d4
AZURE_SPA_CLIENT_ID=a2074980-ae25-4e41-9a02-cc4973ace8d4
# off | optional | required. "optional" accepts anonymous requests and scopes data per user
# when a token is sent; switch to "required" once the frontend signs users in with MSAL.
AUTH_MODE=optional
